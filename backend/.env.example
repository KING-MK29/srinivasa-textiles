# ==========================================================================
# SRINIVASA TEXTILES - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==========================================================================

# Server
PORT=5000
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_key
WEBHOOK_SECRET=change_this_to_a_secure_webhook_secret_key

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Direct Connection
DB_TYPE=postgres
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=postgres

# Fallback Database (SQLite)
SQLITE_DB_PATH=database/srinivasa.db

# CORS Allowed Origins
CORS_ORIGINS=*
